# Optionnel : nginx système sur le VPS (ports 80/443 libres ou sous-domaines)
# Copier vers /etc/nginx/sites-available/baruk après substitution des variables.

upstream baruk_web {
    server 127.0.0.1:8080;
    keepalive 8;
}

upstream baruk_owner {
    server 127.0.0.1:8081;
    keepalive 8;
}

upstream baruk_admin {
    server 127.0.0.1:8082;
    keepalive 8;
}

upstream baruk_staff {
    server 127.0.0.1:8083;
    keepalive 8;
}

server {
    listen 80;
    server_name ${BARUK_DOMAIN};

    location / {
        proxy_pass http://baruk_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name owner.${BARUK_DOMAIN};

    location / {
        proxy_pass http://baruk_owner;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

