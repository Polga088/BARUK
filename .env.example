# BARUK — Développement local (Mac)
# 1. cp .env.example .env
# 2. pnpm db:local   (PostgreSQL Docker)
# 3. pnpm dev

NODE_ENV=development

# PostgreSQL local (docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baruk?schema=public"

AUTH_SECRET="baruk-dev-secret-change-in-production"

# URLs locales — apps Next.js
WEB_URL="http://localhost:3000"
OWNER_URL="http://localhost:3001"
ADMIN_URL="http://localhost:3002"
STAFF_URL="http://localhost:3003"

NEXTAUTH_URL="http://localhost:3001"
AUTH_URL="http://localhost:3001"

NEXT_PUBLIC_OWNER_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"
NEXT_PUBLIC_STAFF_URL="http://localhost:3003"

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_BRANCH_SLUG="casablanca-centre"
NEXT_PUBLIC_ORG_SLUG="baruk"
