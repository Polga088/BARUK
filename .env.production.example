# BARUK — Production / test live VPS
# Sur le VPS : cp .env.production.example .env puis éditer les secrets

NODE_ENV=production

# IP ou domaine du VPS (coexistence CRM Texta : ports 8080-8083)
VPS_HOST=109.123.254.120

# 8090-8093 : Immg utilise déjà 8080 sur le même VPS
WEB_PORT=8090
OWNER_PORT=8091
ADMIN_PORT=8092
STAFF_PORT=8093

WEB_URL=http://109.123.254.120:8090
OWNER_URL=http://109.123.254.120:8091
ADMIN_URL=http://109.123.254.120:8092
STAFF_URL=http://109.123.254.120:8093

NEXT_PUBLIC_OWNER_URL=http://109.123.254.120:8091
NEXT_PUBLIC_ADMIN_URL=http://109.123.254.120:8092
NEXT_PUBLIC_STAFF_URL=http://109.123.254.120:8093

POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://baruk:CHANGE_ME_STRONG_PASSWORD@postgres:5432/baruk?schema=public

AUTH_SECRET=CHANGE_ME_RANDOM_64_CHARS

NEXT_PUBLIC_ORG_SLUG=baruk
NEXT_PUBLIC_BRANCH_SLUG=casablanca-centre
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# true au premier déploiement uniquement
SEED_ON_DEPLOY=false

# Domaine (optionnel — nginx : deploy/nginx/baruk-subdomains.conf.template)
# BARUK_DOMAIN=baruk.votredomaine.com
